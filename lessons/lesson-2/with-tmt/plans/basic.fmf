summary: Run basic tests in a container
discover:
    how: fmf
    test:
     - /tests/smoke
     - /tests/prepare-check
provision:
    how: container
    image: fedora:latest
prepare:
  - how: install
    package:
      - tree
  - how: shell
    script: |
        mkdir -p /tmp/test-workspace
        echo "prepared at $(date)" > /tmp/test-workspace/ready.txt
execute:
    how: tmt

